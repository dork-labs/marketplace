{
  "$schema": "https://dorkos.ai/schemas/dorkos-marketplace.schema.json",
  "schemaVersion": 1,
  "plugins": {
    "marketplace-dev": {
      "type": "skill-pack",
      "categories": ["dev-tools"],
      "layers": ["skills"],
      "icon": "📦",
      "featured": true,
      "pricing": { "model": "free" }
    },
    "flow": {
      "type": "plugin",
      "categories": ["agent-ops", "project-management"],
      "layers": ["commands", "skills", "hooks", "extensions"],
      "icon": "🌊",
      "featured": true,
      "pricing": { "model": "free" }
    },
    "linear-ops": {
      "type": "shape",
      "categories": ["project-management"],
      "layers": ["extensions", "agents", "tasks"],
      "requires": ["plugin:flow@^0.95.0"],
      "icon": "📋",
      "featured": true,
      "pricing": { "model": "free" }
    },
    "writing-pack": {
      "type": "skill-pack",
      "displayName": "Writing Pack",
      "categories": ["documentation", "productivity"],
      "layers": ["skills"],
      "icon": "✍️",
      "pricing": { "model": "free" }
    },
    "safety-hooks": {
      "type": "plugin",
      "displayName": "Safety Hooks",
      "categories": ["agent-ops", "security"],
      "layers": ["hooks"],
      "icon": "🛟",
      "pricing": { "model": "free" }
    },
    "ephemeral-infra": {
      "type": "skill-pack",
      "displayName": "Ephemeral Infra",
      "categories": ["dev-tools", "productivity"],
      "layers": ["skills"],
      "icon": "🧹",
      "pricing": { "model": "free" }
    },
    "visual-companion": {
      "type": "skill-pack",
      "displayName": "Visual Companion",
      "categories": ["dev-tools", "productivity"],
      "layers": ["skills"],
      "icon": "🖼️",
      "pricing": { "model": "free" }
    },
    "miniapp-builder": {
      "type": "agent",
      "displayName": "MiniApp Builder",
      "categories": ["dev-tools", "productivity"],
      "layers": ["agents"],
      "requires": ["skill-pack:app-builder-pack@^1.0.0"],
      "icon": "🧩",
      "pricing": { "model": "free" }
    },
    "app-builder-pack": {
      "type": "skill-pack",
      "displayName": "App Builder Pack",
      "categories": ["dev-tools", "productivity"],
      "layers": ["skills"],
      "icon": "🧩",
      "pricing": { "model": "free" }
    }
  }
}
