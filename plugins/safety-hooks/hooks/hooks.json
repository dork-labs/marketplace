{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/file-guard.mjs\""
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/git-guard.mjs\""
          },
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/process-guard.mjs\""
          }
        ]
      }
    ]
  }
}
