{
  "name": "roadmap",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "The Roadmap extension. It ships no runtime dependencies: DorkOS bundles the extension itself. These dev dependencies are only for its tests, typecheck and format check.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \".dork/extensions/**/*.ts\" vitest.config.ts",
    "format:check": "prettier --check \".dork/extensions/**/*.ts\" vitest.config.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
