{
  "name": "flow",
  "version": "0.55.0",
  "private": true,
  "type": "module",
  "description": "The /flow plugin. The shipped runtime (scripts/*.ts, run via `node --experimental-strip-types`) needs one package, `zod` — install it with `npm install --omit=dev` in this directory. `--include=dev` additionally installs the contributor toolchain (Vitest engine-oracle tests, tsc, Prettier, and the generator that rebuilds config.schema.json from the Zod source).",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"scripts/**/*.ts\" \"engine-tests/**/*.ts\" \"skills/**/*.ts\" \".dork/extensions/**/*.ts\" vitest.config.ts",
    "format:check": "prettier --check \"scripts/**/*.ts\" \"engine-tests/**/*.ts\" \"skills/**/*.ts\" \".dork/extensions/**/*.ts\" vitest.config.ts",
    "generate:schema": "tsx scripts/generate-config-schema.ts"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
