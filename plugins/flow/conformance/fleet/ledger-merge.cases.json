{
  "contract": "fleet",
  "about": "Merging observations into one account's usage ledger (spec flow-cli-core 1.2 'Merging'). Call mergeLedger(existing, observations, now, accountId). input.existing is the parsed ledger file, or null when there is none. Each observation is one window entry plus its window 'key'; an omitted usedPct, resetsAt or status reads as null. Per key, an observation replaces the stored entry only when its observedAt is strictly later; an equal observedAt keeps the stored entry. An observation more than 5 minutes after now is dropped ('observation-future'); an invalid one is dropped ('observation-invalid'); the rest still merge. The merged entry is { usedPct, resetsAt, status, observedAt, source } with usedPct clamped to 0-100 and timestamps normalized to UTC ISO with milliseconds and 'Z'. updatedAt becomes now only when something changed. Unknown ledger fields and unknown window keys are kept. expected.changed says whether the file must be rewritten; expected.ledger is the ledger after the merge; expected.warnings is a multiset of codes (compare sorted).",
  "cases": [
    {
      "name": "the first observation creates the ledger",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:04:11.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 41.5, "resetsAt": "2026-09-26T19:00:00.000Z", "status": null, "observedAt": "2026-09-26T16:04:10.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:04:11.000Z",
          "windows": {
            "five_hour": { "usedPct": 41.5, "resetsAt": "2026-09-26T19:00:00.000Z", "status": null, "observedAt": "2026-09-26T16:04:10.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "a later observation wins even with a lower usedPct (the window reset)",
      "input": {
        "existing": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 90, "resetsAt": "2026-09-26T16:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
            "seven_day": { "usedPct": 40, "resetsAt": "2026-09-30T00:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        },
        "accountId": "claude3",
        "now": "2026-09-26T16:10:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 2, "resetsAt": "2026-09-26T21:00:00.000Z", "status": null, "observedAt": "2026-09-26T16:09:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:10:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 2, "resetsAt": "2026-09-26T21:00:00.000Z", "status": null, "observedAt": "2026-09-26T16:09:00.000Z", "source": "statusline" },
            "seven_day": { "usedPct": 40, "resetsAt": "2026-09-30T00:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "an older observation changes nothing",
      "input": {
        "existing": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 50, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        },
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T14:59:59.999Z", "source": "sdk_usage" }
        ]
      },
      "expected": {
        "changed": false,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 50, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "an equal observedAt keeps the stored entry, so a replay is a no-op",
      "input": {
        "existing": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 50, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        },
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 99, "resetsAt": null, "status": "rejected", "observedAt": "2026-09-26T17:00:00+02:00", "source": "sdk_event" }
        ]
      },
      "expected": {
        "changed": false,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 50, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "more than 5 minutes in the future is dropped; exactly 5 minutes is kept",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T16:05:00.001Z", "source": "statusline" },
          { "key": "seven_day", "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T16:05:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": ["observation-future"],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "seven_day": { "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T16:05:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "invalid observations are dropped and the rest still merge",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "Five-Hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "model:Opus", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": null, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "screen" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00", "source": "statusline" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": "maybe", "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": "10", "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": "tomorrow", "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "source": "statusline" },
          "not an object",
          { "key": "seven_day", "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [
          "observation-invalid", "observation-invalid", "observation-invalid", "observation-invalid", "observation-invalid",
          "observation-invalid", "observation-invalid", "observation-invalid", "observation-invalid", "observation-invalid"
        ],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "seven_day": { "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "usedPct is clamped to 0-100 and timestamps are normalized to UTC",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 104, "resetsAt": "2026-09-26T21:00:00+02:00", "status": null, "observedAt": "2026-09-26T17:59:00+02:00", "source": "statusline" },
          { "key": "seven_day", "usedPct": -3, "resetsAt": null, "status": "allowed", "observedAt": "2026-09-26T15:59:00Z", "source": "sdk_event" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 100, "resetsAt": "2026-09-26T19:00:00.000Z", "status": null, "observedAt": "2026-09-26T15:59:00.000Z", "source": "statusline" },
            "seven_day": { "usedPct": 0, "resetsAt": null, "status": "allowed", "observedAt": "2026-09-26T15:59:00.000Z", "source": "sdk_event" }
          }
        }
      }
    },
    {
      "name": "observations for one key in one batch: the latest wins whatever the order",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 30, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:30:00.000Z", "source": "statusline" },
          { "key": "five_hour", "usedPct": 10, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:10:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 30, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:30:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "new window keys, model buckets and unknown fields are kept",
      "input": {
        "existing": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "writer": "some future writer",
          "windows": {
            "weekly_scale": { "usedPct": 5, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "sdk_usage" },
            "Odd Key": { "anything": true }
          }
        },
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "model:claude-opus-4.1", "usedPct": 12, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:59:00.000Z", "source": "sdk_usage" },
          { "key": "overage", "status": "allowed", "observedAt": "2026-09-26T15:59:00.000Z", "source": "sdk_event" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "writer": "some future writer",
          "windows": {
            "weekly_scale": { "usedPct": 5, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "sdk_usage" },
            "Odd Key": { "anything": true },
            "model:claude-opus-4.1": { "usedPct": 12, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:59:00.000Z", "source": "sdk_usage" },
            "overage": { "usedPct": null, "resetsAt": null, "status": "allowed", "observedAt": "2026-09-26T15:59:00.000Z", "source": "sdk_event" }
          }
        }
      }
    },
    {
      "name": "a stored entry that is not valid is replaced by any valid observation",
      "input": {
        "existing": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T15:00:00.000Z",
          "windows": { "five_hour": { "usedPct": 10, "observedAt": "yesterday", "source": "statusline" } }
        },
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": [],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    },
    {
      "name": "nothing valid to store: a missing ledger stays missing",
      "input": {
        "existing": null,
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": null, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
        ]
      },
      "expected": { "changed": false, "warnings": ["observation-invalid"], "ledger": null }
    },
    {
      "name": "a ledger of an unknown version is left alone",
      "input": {
        "existing": { "v": 2, "accountId": "claude3", "updatedAt": "2026-09-26T15:00:00.000Z", "windows": {} },
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": false,
        "warnings": ["ledger-version-unknown"],
        "ledger": { "v": 2, "accountId": "claude3", "updatedAt": "2026-09-26T15:00:00.000Z", "windows": {} }
      }
    },
    {
      "name": "a ledger that is not a ledger object starts over",
      "input": {
        "existing": ["not", "a", "ledger"],
        "accountId": "claude3",
        "now": "2026-09-26T16:00:00.000Z",
        "observations": [
          { "key": "five_hour", "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
        ]
      },
      "expected": {
        "changed": true,
        "warnings": ["ledger-invalid"],
        "ledger": {
          "v": 1,
          "accountId": "claude3",
          "updatedAt": "2026-09-26T16:00:00.000Z",
          "windows": {
            "five_hour": { "usedPct": 20, "resetsAt": null, "status": null, "observedAt": "2026-09-26T15:00:00.000Z", "source": "statusline" }
          }
        }
      }
    }
  ]
}
