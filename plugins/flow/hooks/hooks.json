{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && node \"${CLAUDE_PLUGIN_ROOT}/hooks/flow-loop.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types \"${CLAUDE_PLUGIN_ROOT}/scripts/flow.ts\" limit-check --hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
